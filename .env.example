# Copy this file to `.env` and fill in the values.
# The .env is git-ignored: never commit secrets.

# --- Twitch ---
# Application registered at https://dev.twitch.tv/console/apps
# OAuth Redirect URL to declare: http://localhost:4343/oauth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Numeric user IDs (not logins). Look them up at:
# https://streamscharts.com/tools/convert-username
TWITCH_BOT_ID=
TWITCH_OWNER_ID=

# --- Wheel of Names (optional: without it, wheel commands are disabled) ---
WHEEL_NAME=
WHEEL_API_KEY=

# --- Spotify (optional: without it, music commands are disabled) ---
# Application created at https://developer.spotify.com/dashboard
# Redirect URI to declare: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Obtained with: python scripts/authorize_spotify.py
SPOTIFY_REFRESH_TOKEN=
# Obtained with the !createsongreward chat command
SPOTIFY_REWARD_ID=

# --- Song request settings (optional) ---
# Maximum accepted track length, in seconds (default 600)
SONG_MAX_DURATION_S=600
# Per-viewer cooldown on !song, in seconds (default 60)
SONG_COOLDOWN_S=60
# Per-viewer cooldown on !queue, in seconds (default 120)
QUEUE_COOLDOWN_S=120

# --- Deployment bootstrap (optional, no use for local dev) ---
# Only consulted when data/.tio.tokens.json or data/custom_commands.json
# don't already exist (e.g. a fresh volume on a new host): seeds that file
# with this variable's raw content, then is never read again. Lets a
# deployment bootstrap data/ through the orchestrator's own env/secret
# storage when there's no practical way to write to that volume directly
# (see the Docker section in the README).
TIO_TOKENS_JSON=
CUSTOM_COMMANDS_JSON=
